# Server
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/restrosaas
JWT_SECRET=your_jwt_secret_here

# Subscription (INR). Use 1 for Razorpay testing; set 799 for production.
SUBSCRIPTION_MONTHLY_PRICE_INR=1

# Set to true to seed Pizza Hub / Curry Palace / Green Garden demo tenants on startup
# SEED_DEMO_DATA=false

# Super admin auto-created on server start (after DB wipe, restart backend or run npm run db:seed-admin)
# SEED_SUPER_ADMIN_EMAIL=admin@orderin.com
# SEED_SUPER_ADMIN_PASSWORD=admin123

# Cashfree Marketplace / Easy Split (nodal settlement — funds never hit platform personal bank)
# Enable Easy Split on your Cashfree PG account before production.
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX
# Legacy aliases (optional): CASHFREE_CLIENT_ID, CASHFREE_CLIENT_SECRET, CASHFREE_ENVIRONMENT

CASHFREE_WEBHOOK_SECRET=your_webhook_secret

# Platform commission % taken from each order (remainder auto-retained in marketplace merchant nodal account)
PLATFORM_COMMISSION_PERCENT=10

# Sandbox vendor KYC (use real PAN in production)
CASHFREE_VENDOR_DEFAULT_PAN=AAAPL1234C
CASHFREE_VENDOR_ACCOUNT_TYPE=BUSINESS
CASHFREE_VENDOR_BUSINESS_TYPE=Food and Beverages

# Redis (optional — queues, socket adapter, rate limits)
REDIS_URL=redis://localhost:6379

# SMTP Email Settings (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
